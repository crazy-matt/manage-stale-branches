{
    "name": "manage-stale-branches",
    "version": "4.0.0",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@octokit/core": "^7.0.8",
        "@octokit/plugin-rest-endpoint-methods": "^18.0.0",
        "@types/debug": "^4.1.13",
        "@types/node": "^24.19.2",
        "@typescript-eslint/eslint-plugin": "^8.71.2",
        "@typescript-eslint/parser": "^8.71.2",
        "@vercel/ncc": "^0.45.0",
        "@vitest/coverage-v8": "^5.0.5",
        "@vitest/ui": "^5.0.5",
        "action-docs": "^2.5.1",
        "eslint": "^10.13.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.7",
        "globals": "^17.13.0",
        "prettier": "^3.9.10",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4",
        "vitest": "^5.0.5"
    },
    "scripts": {
        "install:ci": "pnpm install --frozen-lockfile",
        "reinstall": "command rm -rf node_modules && pnpm install",
        "upgrade": "pnpm update",
        "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
        "format": "prettier --config .linters/prettierrc --write 'src/**/*.{ts,tsx,json}' 'tsconfig*.json'",
        "format:check": "prettier --config .linters/prettierrc --check 'src/**/*.{ts,tsx,json}' 'tsconfig*.json'",
        "lint:fix": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}' --fix",
        "lint": "eslint 'src/**/*.{ts,tsx}' 'tests/**/*.{ts,tsx}'",
        "test": "vitest run --coverage",
        "test:ui": "vitest --ui",
        "dev": "ts-node src/index.ts",
        "build": "bash ./scripts/build.sh",
        "start": "node dist/index.js",
        "gendoc": "action-docs -s action.yml -t 2 --no-banner -u"
    },
    "dependencies": {
        "@actions/core": "^3.0.1",
        "@actions/github": "^9.1.1",
        "ansi-styles": "^7.0.0",
        "debug": "^4.4.3",
        "p-map": "^7.1.1"
    }
}
